# Managed by the sandbox_host Ansible role. Mode 0600 — holds the HMAC secret.
SANDBOX_ACTIVATION_AUTH_SECRET={{ sandbox_activation_auth_secret }}
SANDBOX_COMMAND_UID={{ sandbox_command_uid }}
SANDBOX_COMMAND_GID={{ sandbox_command_gid }}
{% if sandbox_region | length > 0 %}
SANDBOX_REGION={{ sandbox_region }}
{% endif %}
