        {
          "key": "seo_pass",
          "name": "SEO Pass",
          "source_type": "content",
          "content": "# SEO Pass\nSuggest titles, meta, and internal links by intent.\n"
        }
      ],
      "agents": [
        {
          "key": "writer",
