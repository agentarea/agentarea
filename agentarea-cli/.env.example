# Ory Kratos Authentication (used for login/logout)
AGENTAREA_AUTH_KRATOS_URL=http://localhost:4433

# AgentArea Backend API
AGENTAREA_API_URL=http://localhost:8000
AGENTAREA_API_TIMEOUT=30000
AGENTAREA_MAX_RETRIES=3
AGENTAREA_RETRY_DELAY=1000

# SSE Configuration
AGENTAREA_STREAM_TIMEOUT=60000

# Logging
AGENTAREA_LOG_LEVEL=info

# UI Configuration
AGENTAREA_THEME=auto

# Application
NODE_ENV=development
