{
  "bundles": [
    {
      "schema_version": "0.1.0",
      "name": "productivity-lite",
      "display_name": "Productivity Lite",
      "description": "A lightweight assistant that plans your day and triages tasks.",
      "metadata": {
        "developer": "AgentArea",
        "category": "productivity",
        "capabilities": [
          "interactive"
        ]
      },
      "setup": [
        {
          "key": "model",
          "label": "Model",
          "type": "string",
          "required": false,
          "default": "gpt-4o",
          "help": "Provider model id used by the bundle's agents."
        }
      ],
      "skills": [
        {
          "key": "daily_planning",
          "name": "Daily Planning",
          "source_type": "content",
          "content": "# Daily Planning\nPropose a prioritized, time-boxed plan.\n"
        },
        {
          "key": "task_triage",
          "name": "Task Triage",
          "source_type": "content",
          "content": "# Task Triage\nOrder tasks by urgency x importance.\n"
        }
      ],
      "agents": [
        {
          "key": "assistant",
          "name": "Productivity Assistant",
          "model": "${setup.model}",
          "instruction": "You help the user plan their day and triage tasks. Be concise and actionable.",
          "skills": [
            "daily_planning",
            "task_triage"
          ]
        }
      ]
    },
    {
      "schema_version": "0.1.0",
      "name": "research-assistant",
