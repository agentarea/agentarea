# Unified sandbox runtime image.
# Serves both roles:
#   - prod: warm-pool runner pods (published as agentarea/mcp-runner)
#   - dev:  the compose sandbox-executor container
# Debian base (not Alpine): agent workloads need manylinux wheels
# (pandas, lxml, pillow) that do not install on musl.
FROM golang:1.25-alpine AS builder

RUN apk add --no-cache git ca-certificates

WORKDIR /app
COPY go.mod go.sum ./
RUN go mod download
COPY . .

ARG TARGETARCH
ARG TARGETOS
RUN CGO_ENABLED=0 GOOS=${TARGETOS:-linux} GOARCH=${TARGETARCH} go build \
    -a -installsuffix cgo -o bin/activation-service ./cmd/activation-service \
    && CGO_ENABLED=0 GOOS=${TARGETOS:-linux} GOARCH=${TARGETARCH} go build \
    -a -installsuffix cgo -o bin/agentarea-exec-supervisor ./cmd/exec-supervisor

FROM python:3.12-slim-bookworm

RUN apt-get update && apt-get install -y --no-install-recommends \
    bash \
    ca-certificates \
    curl \
    dumb-init \
    file \
    findutils \
    git \
    gzip \
    iptables \
    jq \
    skopeo \
    tar \
    unzip \
    zip \
    && curl -fsSL https://deb.nodesource.com/setup_22.x | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && rm -rf /var/lib/apt/lists/*

# Venv-first: /opt/runtime/venv owns `python` and `pip` on PATH, so agent
# `pip install` works without --break-system-packages (no PEP 668 marker).
ENV PATH=/opt/runtime/venv/bin:$PATH
ENV SANDBOX_COMMAND_UID=10001 SANDBOX_COMMAND_GID=10001
ENV EXEC_SUPERVISOR_PATH=/usr/local/bin/agentarea-exec-supervisor
COPY runtime/requirements.txt /opt/runtime/requirements.txt
RUN python -m venv /opt/runtime/venv \
    && pip install --no-cache-dir -r /opt/runtime/requirements.txt
COPY --from=builder /app/bin/agentarea-exec-supervisor /usr/local/bin/agentarea-exec-supervisor

# The version stamped into the runtime manifest, from the VERSION file via the
# build workflow's APP_VERSION — one version source rather than a second one to
# forget.
#
# Deliberately declared with NO default. A default is what caused the bug this
# replaced: the old `ARG RUNTIME_VERSION=dev` was passed by nobody, so "dev" was
# not a fallback for local builds, it was the only value any published image
# ever carried — and the manifest silently lied about which build was running.
# With no default, a build site that forgets to pass a version fails at
# generate_manifest.py ("RUNTIME_VERSION must be set at build time") instead of
# shipping a plausible-looking wrong answer. Every build site now states its
# own version, including compose.
ARG APP_VERSION
COPY runtime/generate_manifest.py /opt/runtime/generate_manifest.py
RUN mkdir -p /etc/agentarea \
    && chown -R 10001:10001 /opt/runtime/venv \
    && RUNTIME_VERSION=${APP_VERSION} python /opt/runtime/generate_manifest.py \
       > /etc/agentarea/runtime.json \
    && cat /etc/agentarea/runtime.json \
    && find /opt/runtime -type d -name __pycache__ -prune -exec rm -rf '{}' +

# The activation service may retain its container privileges for image-overlay
# work, but every task command is dropped to this dedicated uid by the service.
RUN useradd --uid 10001 --create-home sandbox \
    && mkdir -p /workspace /app/mcp-overlay /var/cache/mcp-images \
    && chmod 777 /workspace \
    && chown -R sandbox:sandbox /workspace /app/mcp-overlay /var/cache/mcp-images

COPY --from=builder /app/bin/activation-service /usr/local/bin/activation-service

# 8080 - Activation API, 3000 - MCP protocol (configurable)
EXPOSE 8080 3000

ENTRYPOINT ["/usr/bin/dumb-init", "--"]
CMD ["/usr/local/bin/activation-service"]
