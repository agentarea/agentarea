{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node", "bun"],
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["app/*"],
      "@shared/*": ["shared/*"],
      "@kit/*": ["../mcp-apps-kit/*"],
      "@modelcontextprotocol/ext-apps/react": [
        "./node_modules/@modelcontextprotocol/ext-apps/dist/src/react/index.d.ts"
      ],
      "*": ["./node_modules/@types/*", "./node_modules/*"]
    }
  },
  "include": ["app", "host", "server", "shared", "scripts", "vite.config.ts", "../mcp-apps-kit/store", "../mcp-apps-kit/events", "../mcp-apps-kit/context"]
}
