{
  "source_types": [
    {
      "slug": "generic_webhook",
      "name": "Webhook",
      "description": "Any sender: HMAC over the body with a secret that is issued if you give none. Set the key field to dedupe its retries.",
      "icon": "webhook",
      "delivery": "webhook",
      "credentials": [
        {
          "key": "signing_secret",
          "label": "Signing Secret",
          "placeholder": "Leave empty to have one issued",
          "required": false,
          "issued": true
        }
      ],
      "config": [
        {
          "key": "scheme",
          "label": "Verification",
          "placeholder": "hmac, hmac_timestamped or shared_token",
          "required": false,
          "issued": false
        },
        {
          "key": "header",
          "label": "Signature Header",
          "placeholder": "X-Webhook-Signature",
          "required": false,
          "issued": false
        },
        {
          "key": "algorithm",
          "label": "HMAC Digest",
          "placeholder": "sha256",
          "required": false,
          "issued": false
        },
        {
          "key": "prefix",
          "label": "Signature Prefix",
          "placeholder": "e.g. sha256=",
          "required": false,
          "issued": false
        }
      ],
      "verification": {
        "scheme": "hmac",
        "secret": "signing_secret",
        "header": "X-Webhook-Signature",
        "configurable": [
          "scheme",
          "header",
          "algorithm",
          "prefix"
        ]
      },
      "event": {
        "kind": "webhook",
        "key": [
          "{header:webhook-id}",
          "{header:idempotency-key}"
        ]
      },
      "events": []
    },
    {
      "slug": "github",
      "name": "GitHub",
      "description": "Repository and organization webhooks: pushes, pull requests, issues, releases",
      "icon": "github",
      "delivery": "webhook",
      "credentials": [
        {
          "key": "webhook_secret",
          "label": "Webhook Secret",
          "placeholder": "Secret configured on the GitHub webhook",
          "required": true,
          "issued": false
        }
      ],
      "verification": {
        "scheme": "hmac",
        "secret": "webhook_secret",
        "header": "X-Hub-Signature-256",
        "prefix": "sha256="
      },
      "handshake": [],
      "event": {
        "kind": [
          "{header:x-github-event}.{body:action}",
          "{header:x-github-event}"
        ],
        "key": "{header:x-github-delivery}",
        "sender": "github:{body:sender.login}"
      },
      "events": [
        "push",
        "pull_request.opened",
        "pull_request.closed",
        "pull_request.reopened",
        "pull_request.synchronize",
        "pull_request.review_requested",
        "pull_request_review.submitted",
        "issues.opened",
        "issues.closed",
        "issues.labeled",
        "issue_comment.created",
        "release.published",
        "workflow_run.completed",
        "check_run.completed",
        "check_suite.completed",
        "deployment",
        "deployment_status",
        "create",
        "delete",
        "fork",
        "star.created",
        "watch.started",
        "repository.created",
        "commit_comment.created",
        "status",
        "ping"
      ]
    },
    {
      "slug": "slack",
      "name": "Slack",
      "description": "Events API deliveries of a Slack app; the agent answers in the thread",
      "icon": "slack",
      "delivery": "webhook",
      "credentials": [
        {
          "key": "signing_secret",
          "label": "Signing Secret",
          "placeholder": "Your Slack app's signing secret",
          "required": true,
          "issued": false
        },
        {
          "key": "bot_token",
          "label": "Bot Token",
          "placeholder": "xoxb-… to reply in Slack",
          "required": false,
          "issued": false
        }
      ],
      "verification": {
        "scheme": "hmac_timestamped",
        "secret": "signing_secret",
        "header": "X-Slack-Signature",
        "timestamp_header": "X-Slack-Request-Timestamp",
        "payload": "v0:{timestamp}:{body}",
        "prefix": "v0="
      },
      "handshake": [
        {
          "when": "{body:type}",
          "equals": "url_verification",
          "respond": {
            "challenge": "{body:challenge}"
          }
        }
      ],
      "event": {
        "kind": [
          "{body:event.type}",
          "{body:type}",
          "command"
        ],
        "key": [
          "{body:event_id}",
          "{body:trigger_id}"
        ],
        "session_key": "{body:event.channel}:{body:event.thread_ts|event.ts}",
        "sender": "slack:{body:event.user|user_id|user.id}",
        "occurred_at": "{body:event_time}",
        "attachments": {
          "path": "event.files",
          "fetch": "slack.url_private"
        }
      },
      "events": [
        "message",
        "app_mention",
        "reaction_added",
        "reaction_removed",
        "channel_created",
        "channel_archive",
        "member_joined_channel",
        "member_left_channel",
        "file_shared",
        "app_home_opened",
        "link_shared",
        "command"
      ],
      "reply": {
        "sender": "http",
        "target": {
          "channel": "{body:event.channel|channel_id}",
          "thread_ts": "{body:event.thread_ts|event.ts}"
        },
        "presentation": "concise",
        "request": {
          "method": "POST",
          "url": "https://slack.com/api/chat.postMessage",
          "headers": {
            "Authorization": "Bearer {credentials.bot_token}"
          },
          "json": {
            "channel": "{target:channel}",
            "text": "{message}",
            "mrkdwn": true,
            "thread_ts": "{target:thread_ts}"
          }
        },
        "markup": "slack",
        "limit": 3000,
        "permanent_errors": [
          "invalid_auth",
          "not_authed",
          "channel_not_found",
          "not_in_channel",
          "account_inactive",
          "is_archived"
        ]
      }
    },
    {
      "slug": "telegram",
      "name": "Telegram",
      "description": "Updates of a Telegram bot, by webhook (registered with the bot for you) or by polling",
      "icon": "telegram",
      "delivery": "both",
      "credentials": [
        {
          "key": "bot_token",
          "label": "Bot Token",
          "placeholder": "Token from @BotFather",
          "required": true,
          "issued": false
        },
        {
          "key": "secret_token",
          "label": "Webhook Secret Token",
          "placeholder": "Leave empty to have one issued",
          "required": false,
          "issued": true
        }
      ],
      "verification": {
        "scheme": "shared_token",
        "secret": "secret_token",
        "header": "X-Telegram-Bot-Api-Secret-Token"
      },
      "registration": {
        "register": {
          "method": "POST",
          "url": "https://api.telegram.org/bot{credentials.bot_token}/setWebhook",
          "json": {
            "url": "{webhook_url}",
            "secret_token": "{credentials.secret_token}"
          }
        },
        "unregister": {
          "method": "POST",
          "url": "https://api.telegram.org/bot{credentials.bot_token}/deleteWebhook"
        }
      },
      "poll": {
        "transport": "http_json",
        "request": {
          "method": "GET",
          "url": "https://api.telegram.org/bot{credentials.bot_token}/getUpdates?offset={cursor}&timeout=30"
        },
        "items": "result",
        "cursor": "{item:update_id}+1",
        "interval": "0s"
      },
      "event": {
        "kind": "{first_key:message|edited_message|channel_post|edited_channel_post|callback_query|inline_query|chosen_inline_result|shipping_query|pre_checkout_query|poll|poll_answer|my_chat_member|chat_member|chat_join_request}",
        "key": "update:{body:update_id}",
        "session_key": "{body:message.chat.id|edited_message.chat.id|channel_post.chat.id|edited_channel_post.chat.id|callback_query.message.chat.id|my_chat_member.chat.id|chat_member.chat.id|chat_join_request.chat.id}",
        "sender": "tg:{body:message.from.id|edited_message.from.id|callback_query.from.id|inline_query.from.id|my_chat_member.from.id|chat_member.from.id|chat_join_request.from.id}",
        "occurred_at": "{body:message.date|edited_message.date|channel_post.date|edited_channel_post.date}",
        "attachments": {
          "path": "message.document|message.photo[-1]|message.video|message.voice|message.audio|message.animation|message.video_note",
          "fetch": "telegram.getFile"
        }
      },
      "events": [
        "message",
        "edited_message",
        "channel_post",
        "edited_channel_post",
        "callback_query",
        "inline_query",
        "chosen_inline_result",
        "shipping_query",
        "pre_checkout_query",
        "poll",
        "poll_answer",
        "my_chat_member",
        "chat_member",
        "chat_join_request"
      ],
      "admission": {
        "identity": "telegram",
        "external_id": "{body:message.from.id|edited_message.from.id|callback_query.from.id|inline_query.from.id|my_chat_member.from.id|chat_member.from.id|chat_join_request.from.id}",
        "chat": "{body:message.chat.id|edited_message.chat.id|channel_post.chat.id|edited_channel_post.chat.id|callback_query.message.chat.id|my_chat_member.chat.id|chat_member.chat.id|chat_join_request.chat.id}",
        "text": "{body:message.text|edited_message.text|message.caption}",
        "private": "{body:message.chat.type|edited_message.chat.type|callback_query.message.chat.type}",
        "is_bot": "{body:message.from.is_bot|edited_message.from.is_bot|callback_query.from.is_bot}"
      },
      "reply": {
        "sender": "telegram_live",
        "target": {
          "chat_id": "{body:message.chat.id|edited_message.chat.id|channel_post.chat.id|edited_channel_post.chat.id|callback_query.message.chat.id|my_chat_member.chat.id|chat_member.chat.id|chat_join_request.chat.id}",
          "message_id": "{body:message.message_id|edited_message.message_id|callback_query.message.message_id}"
        },
        "presentation": "concise",
        "markup": "telegram",
        "limit": 4096,
        "permanent_errors": [
          "chat not found",
          "bot was blocked by the user",
          "bot was kicked",
          "Unauthorized"
        ]
      }
    },
