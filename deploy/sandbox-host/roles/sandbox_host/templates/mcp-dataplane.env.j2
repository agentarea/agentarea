# Rendered by the sandbox_host role. Contains the shared data-plane token.
MCP_MANAGER_MODE=dataplane
MCP_DATAPLANE_ID={{ sandbox_mcp_dataplane_id }}
MCP_DATAPLANE_AUTH_TOKEN={{ sandbox_mcp_dataplane_auth_token }}
MCP_DATAPLANE_LISTEN_ADDR=0.0.0.0:{{ sandbox_mcp_dataplane_port }}

# Declared rather than detected. A container with a mounted Docker socket also
# has a kubeconfig-shaped environment often enough that auto-detection picks
# Kubernetes and tries to reach a cluster that is not there.
BACKEND_TYPE=docker
CONTAINER_RUNTIME=docker

# Network MCP instance containers join. The data plane reaches them on it, so it
# must be the same one this container is attached to.
MCP_NETWORK={{ sandbox_mcp_dataplane_network }}

# The data plane has no Core API to sync against — it is told what to run.
SKIP_INSTANCE_SYNC=true

# Isolation for spawned MCP instances. gVisor is why this host exists.
DEFAULT_ISOLATION_TIER={{ sandbox_mcp_dataplane_isolation_tier }}

LOG_LEVEL={{ sandbox_mcp_dataplane_log_level }}
