    {
      "schema_version": "0.1.0",
      "name": "customer-support",
      "display_name": "Customer Support",
      "description": "Front-line support assistant with an escalation policy.",
      "metadata": {
        "developer": "AgentArea",
        "category": "support",
        "capabilities": [
          "interactive"
        ]
      },
      "setup": [
        {
          "key": "model",
          "label": "Model",
          "type": "string",
          "required": false,
          "default": "gpt-4o",
          "help": "Provider model id used by the bundle's agents."
        }
      ],
      "skills": [
        {
          "key": "support_tone",
          "name": "Support Tone",
          "source_type": "content",
          "content": "# Support Tone\nEmpathetic, precise; escalate when unsure.\n"
        }
      ],
      "agents": [
        {
          "key": "support",
          "name": "Support Agent",
          "model": "${setup.model}",
          "instruction": "Resolve customer questions accurately and kindly.",
          "skills": [
            "support_tone"
          ]
        }
      ],
      "policies": [
        {
          "key": "deny_refunds",
          "target": "tool:issue_refund",
          "effect": "deny",
          "message": "Never issue refunds autonomously."
        },
        {
          "key": "approve_escalation",
          "target": "tool:escalate",
          "effect": "approval",
          "message": "Confirm before escalating to a human."
        }
      ]
    },
    {
      "schema_version": "0.1.0",
