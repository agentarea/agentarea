    {
      "slug": "discord",
      "name": "Discord",
      "description": "Interactions of a Discord application; the agent answers in the channel",
      "icon": "discord",
      "delivery": "webhook",
      "credentials": [
        {
          "key": "public_key",
          "label": "Application Public Key",
          "placeholder": "Your Discord app's public key",
          "required": true,
          "issued": false
        },
        {
          "key": "bot_token",
          "label": "Bot Token",
          "placeholder": "To reply in Discord",
          "required": false,
          "issued": false
        }
      ],
      "verification": {
        "scheme": "ed25519",
        "secret": "public_key",
        "header": "X-Signature-Ed25519",
        "timestamp_header": "X-Signature-Timestamp",
        "payload": "{timestamp}{body}"
      },
      "handshake": [
        {
          "when": "{body:type}",
          "equals": "1",
          "respond": {
            "type": 1
          }
        }
      ],
      "event": {
        "kind": [
          "{body:t}",
          "interaction.{body:type}"
        ],
        "key": "{body:id|d.id}",
        "session_key": "{body:channel_id|d.channel_id}",
        "sender": "discord:{body:member.user.id|user.id|d.author.id|author.id}",
        "occurred_at": "{body:d.timestamp|timestamp}",
        "attachments": {
          "path": "d.attachments|data.resolved.attachments.*|attachments",
          "fetch": "url"
        }
      },
      "events": [
        "interaction.2",
        "interaction.3",
        "interaction.4",
        "interaction.5",
        "MESSAGE_CREATE",
        "MESSAGE_UPDATE",
        "MESSAGE_DELETE",
        "MESSAGE_REACTION_ADD",
        "GUILD_MEMBER_ADD",
        "THREAD_CREATE"
      ],
      "reply": {
        "sender": "http",
        "target": {
          "channel_id": "{body:channel_id|d.channel_id}",
          "message_id": "{body:d.id|message.id}"
        },
        "presentation": "concise",
        "request": {
          "method": "POST",
          "url": "https://discord.com/api/v10/channels/{target:channel_id}/messages",
          "headers": {
            "Authorization": "Bot {credentials.bot_token}"
          },
          "json": {
            "content": "{message}",
            "message_reference": {
              "message_id": "{target:message_id}"
            }
          }
        },
        "markup": "discord",
        "limit": 2000,
        "permanent_errors": [
          "Unknown Channel",
          "Missing Access",
          "401: Unauthorized"
        ]
      }
    },
