@baseUrl = http://localhost:8000
@token = aat_xhymm4Sy6KORfYOSL0vvnCU2G309SkYTkjeGsC2rrm0

### =============================================
### API Keys
### =============================================

### List API Keys
GET {{baseUrl}}/v1/api-keys/
Authorization: Bearer {{token}}

### Create API Key
POST {{baseUrl}}/v1/api-keys/
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "test-key-cli",
  "expires_in_days": 90
}

### Get API Key by ID (replace with actual ID)
GET {{baseUrl}}/v1/api-keys/{{apiKeyId}}
Authorization: Bearer {{token}}

### Revoke API Key (replace with actual ID)
DELETE {{baseUrl}}/v1/api-keys/{{apiKeyId}}
Authorization: Bearer {{token}}

### =============================================
### Agents (needed for trigger creation)
### =============================================

### List Agents
GET {{baseUrl}}/v1/agents/
Authorization: Bearer {{token}}

### Get Agent by ID
GET {{baseUrl}}/v1/agents/{{agentId}}
Authorization: Bearer {{token}}

### =============================================
### Triggers
### =============================================

### List All Triggers
GET {{baseUrl}}/v1/triggers/
Authorization: Bearer {{token}}

### List Triggers by Agent
GET {{baseUrl}}/v1/triggers/?agent_id={{agentId}}
Authorization: Bearer {{token}}

### List Active Triggers Only
GET {{baseUrl}}/v1/triggers/?active_only=true
Authorization: Bearer {{token}}

### Create Cron Trigger (replace agent_id)
POST {{baseUrl}}/v1/triggers/
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Daily Report Generator",
  "trigger_type": "cron",
  "agent_id": "{{agentId}}",
  "config": {
    "cron_expression": "0 9 * * 1-5",
    "timezone": "UTC"
  },
  "task_parameters": {
    "prompt": "Generate the daily report"
  },
  "failure_threshold": 3
}

### Create Webhook Trigger (replace agent_id)
POST {{baseUrl}}/v1/triggers/
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "GitHub Push Handler",
  "trigger_type": "webhook",
  "agent_id": "{{agentId}}",
  "config": {
    "webhook_type": "github",
    "allowed_methods": ["POST"]
  },
  "task_parameters": {
    "prompt": "Process the incoming webhook payload"
  },
  "failure_threshold": 5
}

### Get Trigger by ID
GET {{baseUrl}}/v1/triggers/{{triggerId}}
Authorization: Bearer {{token}}

### Update Trigger
PUT {{baseUrl}}/v1/triggers/{{triggerId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Updated Trigger Name",
  "config": {
    "cron_expression": "0 10 * * *",
    "timezone": "America/New_York"
  },
  "failure_threshold": 5
}

### Enable Trigger
POST {{baseUrl}}/v1/triggers/{{triggerId}}/enable
Authorization: Bearer {{token}}

### Disable Trigger
POST {{baseUrl}}/v1/triggers/{{triggerId}}/disable
Authorization: Bearer {{token}}

### Get Trigger Status
GET {{baseUrl}}/v1/triggers/{{triggerId}}/status
Authorization: Bearer {{token}}

### Get Trigger Executions
GET {{baseUrl}}/v1/triggers/{{triggerId}}/executions?page=1&page_size=20
Authorization: Bearer {{token}}

### Get Trigger Metrics
GET {{baseUrl}}/v1/triggers/{{triggerId}}/metrics
Authorization: Bearer {{token}}

### Get Trigger Timeline
GET {{baseUrl}}/v1/triggers/{{triggerId}}/timeline
Authorization: Bearer {{token}}

### Get Trigger Correlations
GET {{baseUrl}}/v1/triggers/{{triggerId}}/correlations
Authorization: Bearer {{token}}

### Get Channel Events Registry (all supported events per channel)
GET {{baseUrl}}/v1/triggers/channels/events
Authorization: Bearer {{token}}

### Create Trigger with Event Filters + Credentials
POST {{baseUrl}}/v1/triggers/
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "GitHub PR Watcher",
  "trigger_type": "webhook",
  "agent_id": "{{agentId}}",
  "config": {
    "webhook_type": "github",
    "allowed_methods": ["POST"]
  },
  "event_types": ["pull_request.opened", "pull_request.closed", "issues.opened"],
  "channel_credentials": {
    "webhook_secret": "your-github-webhook-secret"
  },
  "task_parameters": {
    "prompt": "Review this PR event"
  },
  "failure_threshold": 3
}

### Create Slack Trigger with Event Filters
POST {{baseUrl}}/v1/triggers/
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Slack Message Handler",
  "trigger_type": "webhook",
  "agent_id": "{{agentId}}",
  "config": {
    "webhook_type": "slack",
    "allowed_methods": ["POST"]
  },
  "event_types": ["message", "app_mention"],
  "channel_credentials": {
    "signing_secret": "your-slack-signing-secret"
  },
  "task_parameters": {
    "prompt": "Respond to this Slack message"
  }
}

### Triggers Health
GET {{baseUrl}}/v1/triggers/health
Authorization: Bearer {{token}}

### Delete Trigger
DELETE {{baseUrl}}/v1/triggers/{{triggerId}}
Authorization: Bearer {{token}}

### =============================================
### Workspace Import/Export
### =============================================

### Export Workspace (returns YAML)
GET {{baseUrl}}/v1/workspace/export
Authorization: Bearer {{token}}

### Import Workspace (from YAML string)
POST {{baseUrl}}/v1/workspace/import
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "config": "agents:\n  - name: test-agent\n    description: A test agent",
  "skip_missing_dependencies": true,
  "override_existing": false
}

### =============================================
### MCP Server Instances
### =============================================

### List MCP Server Instances
GET {{baseUrl}}/v1/mcp-server-instances/
Authorization: Bearer {{token}}

### MCP Health Status (all containers)
GET {{baseUrl}}/v1/mcp-server-instances/health/containers
Authorization: Bearer {{token}}

### Discover MCP Instance Tools (replace instance_id)
POST {{baseUrl}}/v1/mcp-server-instances/{{mcpInstanceId}}/discover-tools
Authorization: Bearer {{token}}

### =============================================
### Skills
### =============================================

### List Skills
GET {{baseUrl}}/v1/skills/
Authorization: Bearer {{token}}

### Get Skill by ID
GET {{baseUrl}}/v1/skills/{{skillId}}
Authorization: Bearer {{token}}

### List Skill Members (bundle children)
GET {{baseUrl}}/v1/skills/{{skillId}}/members
Authorization: Bearer {{token}}

### Flatten Skill (execution order)
GET {{baseUrl}}/v1/skills/{{skillId}}/flatten
Authorization: Bearer {{token}}

### =============================================
### Model Instances
### =============================================

### List Model Instances
GET {{baseUrl}}/v1/model-instances/
Authorization: Bearer {{token}}

### Test Model Instance
POST {{baseUrl}}/v1/model-instances/test
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "provider_config_id": "{{providerConfigId}}",
  "model_spec_id": "{{modelSpecId}}",
  "test_message": "Hello, can you hear me?"
}

### =============================================
### Provider Configs
### =============================================

### List Provider Configs
GET {{baseUrl}}/v1/provider-configs/
Authorization: Bearer {{token}}

### List Provider Specs with Models
GET {{baseUrl}}/v1/provider-specs/with-models
Authorization: Bearer {{token}}
