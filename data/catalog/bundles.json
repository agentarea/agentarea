    {
      "schema_version": "0.1.0",
      "name": "inbox-zero",
      "display_name": "Inbox Zero",
      "description": "Triage your inbox via a connected mail MCP, with a daily summary.",
      "metadata": {
        "developer": "AgentArea",
        "category": "productivity",
        "capabilities": [
          "interactive"
        ]
      },
      "setup": [
        {
          "key": "model",
          "label": "Model",
          "type": "string",
          "required": false,
          "default": "gpt-4o",
          "help": "Provider model id used by the bundle's agents."
        }
      ],
      "skills": [
        {
          "key": "triage_rules",
          "name": "Triage Rules",
          "source_type": "content",
          "content": "# Triage Rules\nGroup by urgency; draft routine replies.\n"
        }
      ],
      "mcps": [
        {
          "key": "mail",
          "name": "Mail Connector",
          "json_spec": {
            "type": "url",
            "endpoint_url": "https://mcp.example.com/mail"
          }
        }
      ],
      "agents": [
        {
          "key": "triager",
          "name": "Email Triager",
          "model": "${setup.model}",
          "instruction": "Triage the inbox and surface what needs attention.",
          "skills": [
            "triage_rules"
          ],
          "mcps": [
            "mail"
          ]
        }
      ],
      "automations": [
        {
          "key": "daily_digest",
          "type": "cron",
          "cron": "0 8 * * *",
          "timezone": "UTC",
          "agent": "triager",
          "prompt": "Summarize new email since yesterday and list the top 3 actions.",
          "enabled": false
        }
      ],
      "policies": [
        {
          "key": "approve_send_email",
          "target": "tool:send_email",
          "effect": "approval",
          "message": "Ask before sending any email on your behalf."
        },
        {
          "key": "cap_monthly_spend",
          "target": "spend",
          "effect": "cap",
          "params": {
            "amount_usd": 20,
            "period": "month"
          },
          "message": "Cap automated spend at $20 / month."
        }
      ]
    },
