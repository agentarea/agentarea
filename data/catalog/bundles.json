        }
      ],
      "agents": [
        {
          "key": "sdr",
          "name": "Outreach Writer",
          "model": "${setup.model}",
          "instruction": "Write B2B cold emails that get replies.",
          "skills": [
            "cold_email"
          ]
        }
      ],
      "policies": [
        {
          "key": "approve_outreach",
          "target": "tool:send_email",
          "effect": "approval",
          "message": "Approve outreach emails before they send."
        },
        {
          "key": "cap_daily_contacts",
          "target": "actions",
          "effect": "cap",
          "params": {
            "count": 200,
            "period": "day"
          },
          "message": "Limit to 200 contacts per day."
        }
      ]
    },
