[Unit]
Description=AgentArea OpenSandbox data plane
After=docker.service sandbox-egress.service opensandbox-input-firewall.service
Requires=docker.service sandbox-egress.service opensandbox-input-firewall.service

[Service]
Type=oneshot
RemainAfterExit=true
WorkingDirectory=/etc/opensandbox
ExecStart=/usr/bin/docker compose --env-file /etc/opensandbox/compose.env -f /etc/opensandbox/compose.yaml up -d --remove-orphans
ExecReload=/usr/bin/docker compose --env-file /etc/opensandbox/compose.env -f /etc/opensandbox/compose.yaml up -d --remove-orphans
ExecStop=/usr/bin/docker compose --env-file /etc/opensandbox/compose.env -f /etc/opensandbox/compose.yaml down
TimeoutStartSec=300
TimeoutStopSec=60

[Install]
WantedBy=multi-user.target
