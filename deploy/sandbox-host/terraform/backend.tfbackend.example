# Copy to backend.tfbackend and fill from the bootstrap root:
#   cd bootstrap && terraform output -raw bucket
#   cd bootstrap && terraform output -raw endpoint
#
# The credential is NOT here. Export it instead, so it never lands in a file
# next to the code:
#   export AWS_ACCESS_KEY_ID=$(cd bootstrap && terraform output -raw access_key)
#   export AWS_SECRET_ACCESS_KEY=$(cd bootstrap && terraform output -raw secret_key)
bucket = "<prefix>-agentarea-tfstate"
region = "ru-1"

endpoints = {
  s3 = "https://s3.twcstorage.ru"
}
