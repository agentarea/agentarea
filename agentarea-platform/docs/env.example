# Kratos Authentication Configuration
# AGENTAREA_AUTH_JWKS_B64: Base64-encoded JWKS from Kratos (for JWT verification)
# AGENTAREA_AUTH_ISSUER: JWT issuer URL (must match token 'iss' claim)
# AGENTAREA_AUTH_AUDIENCE: JWT audience (must match token 'aud' claim)
# These have default test values in config/app.py for local development

# Database Configuration
AGENTAREA_DB_HOST=localhost
AGENTAREA_DB_PORT=5432
AGENTAREA_DB_USER=user
AGENTAREA_DB_PASSWORD=password
AGENTAREA_DB_NAME=agentarea

# Redis Configuration
AGENTAREA_REDIS_URL=redis://localhost:6379

# Other settings...
DEBUG=false
APP_ENV=development 