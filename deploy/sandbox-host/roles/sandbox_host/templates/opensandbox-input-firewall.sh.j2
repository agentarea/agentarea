#!/usr/bin/env bash
set -euo pipefail

# Everything this host serves is reachable to whoever can route to it: the
# OpenSandbox API fronts a Docker socket, and the data plane creates containers.
# Both authenticate, but a port open to a whole network is one credential bug
# away from the host, so the network is closed first and the credential second.
CHAIN=AGENTAREA-INPUT
iptables -N "$CHAIN" 2>/dev/null || true
iptables -F "$CHAIN"

# Local health checks and proxy traffic.
iptables -A "$CHAIN" -s 127.0.0.0/8 -j RETURN

{% for port in opensandbox_guarded_ports %}
{% for cidr in opensandbox_control_plane_cidrs %}
iptables -A "$CHAIN" -p tcp -s {{ cidr }} --dport {{ port }} -j RETURN
{% endfor %}
iptables -A "$CHAIN" -p tcp --dport {{ port }} -j DROP
{% endfor %}
iptables -A "$CHAIN" -j RETURN

iptables -C INPUT -j "$CHAIN" 2>/dev/null ||
  iptables -I INPUT 1 -j "$CHAIN"

# The same policy over IPv6. The provider hands these hosts a globally routable
# IPv6 address whether or not anything is bound to it, so a v4-only chain guards
# the front door and leaves the back one open the moment a service -- the TLS
# proxy runs with host networking -- listens on both families.
if command -v ip6tables >/dev/null 2>&1; then
  ip6tables -N "$CHAIN" 2>/dev/null || true
  ip6tables -F "$CHAIN"
  ip6tables -A "$CHAIN" -s ::1/128 -j RETURN
  # ssh is guarded here too. Its listen address is a sshd setting that only takes
  # effect when this role is told one, and the provider's image binds [::] by
  # default -- so on a host with no public IPv4 the only reachable way in was the
  # address nobody chose.
{% for port in opensandbox_guarded_ports + [22] %}
{% for cidr in opensandbox_control_plane_cidrs_v6 %}
  ip6tables -A "$CHAIN" -p tcp -s {{ cidr }} --dport {{ port }} -j RETURN
{% endfor %}
  ip6tables -A "$CHAIN" -p tcp --dport {{ port }} -j DROP
{% endfor %}
  ip6tables -A "$CHAIN" -j RETURN

  ip6tables -C INPUT -j "$CHAIN" 2>/dev/null ||
    ip6tables -I INPUT 1 -j "$CHAIN"
fi
