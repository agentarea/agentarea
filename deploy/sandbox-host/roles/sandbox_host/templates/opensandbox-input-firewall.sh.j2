#!/usr/bin/env bash
set -euo pipefail

CHAIN=AGENTAREA-INPUT
iptables -N "$CHAIN" 2>/dev/null || true
iptables -F "$CHAIN"

# Local health checks and proxy traffic.
iptables -A "$CHAIN" -s 127.0.0.0/8 -j RETURN

{% for cidr in opensandbox_control_plane_cidrs %}
iptables -A "$CHAIN" -p tcp -s {{ cidr }} --dport 443 -j RETURN
# Keep the legacy executor reachable during the controlled migration only.
iptables -A "$CHAIN" -p tcp -s {{ cidr }} --dport {{ sandbox_executor_host_port }} -j RETURN
{% endfor %}

iptables -A "$CHAIN" -p tcp --dport 443 -j DROP
iptables -A "$CHAIN" -p tcp --dport {{ sandbox_executor_host_port }} -j DROP
iptables -A "$CHAIN" -j RETURN

iptables -C INPUT -j "$CHAIN" 2>/dev/null ||
  iptables -I INPUT 1 -j "$CHAIN"
