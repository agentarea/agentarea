#!/usr/bin/env bash
# Managed by the sandbox_host Ansible role.
#
# Runs after docker starts (systemd ordering) and rebuilds the DOCKER-USER chain
# so untrusted CONTAINER-INITIATED egress cannot reach the cloud metadata service
# or private networks, while public egress (pip/npm) and inbound traffic to
# published container ports (the executor's :8080) keep working.
#
# Critical: the DROP rules match on the incoming bridge interface (-i docker0 /
# br+), i.e. traffic ENTERING the FORWARD chain from a container. Matching on
# destination alone would also drop the REPLY packets (whose destination is the
# container's own RFC1918 bridge IP) and break ALL egress.
set -euo pipefail

# DOCKER-USER must already exist AND be referenced from FORWARD. If not, Docker
# is not managing iptables (nft-only path, iptables=false, ...) and this firewall
# would be silently inert — fail hard rather than create an orphan chain that
# enforces nothing.
if ! iptables -S DOCKER-USER >/dev/null 2>&1; then
  echo "FATAL: DOCKER-USER chain absent - Docker is not managing iptables; refusing to run with no egress enforcement" >&2
  exit 1
fi
if ! iptables -S FORWARD 2>/dev/null | grep -q -- '-j DOCKER-USER'; then
  echo "FATAL: FORWARD does not jump to DOCKER-USER - egress rules would be dead" >&2
  exit 1
fi

# Rebuild idempotently and in deterministic order.
iptables -F DOCKER-USER

# Allow replies to connections the container itself opened.
iptables -A DOCKER-USER -m conntrack --ctstate ESTABLISHED,RELATED -j RETURN

# Block container-initiated traffic (from any docker bridge) to metadata + RFC1918.
# If you run a private package mirror, insert an ACCEPT/RETURN for its CIDR here,
# before these DROP rules.
for IFACE in docker0 'br+'; do
{% for cidr in sandbox_egress_deny %}
  iptables -A DOCKER-USER -i "$IFACE" -d {{ cidr }} -j DROP
{% endfor %}
done

# Inbound traffic to a published container port never reaches the INPUT chain:
# Docker DNATs it and it traverses FORWARD, so the guard for those ports has to
# live here, in the chain Docker gives us -- and in this file, because this script
# flushes DOCKER-USER on every run.
#
# Only new connections are judged; established ones already passed.
{% for port in sandbox_published_guarded_ports %}
{% for cidr in opensandbox_control_plane_cidrs %}
iptables -A DOCKER-USER -m conntrack --ctstate NEW -s {{ cidr }} -p tcp --dport {{ port }} -j RETURN
{% endfor %}
iptables -A DOCKER-USER -m conntrack --ctstate NEW -p tcp --dport {{ port }} -j DROP
{% endfor %}
iptables -A DOCKER-USER -j RETURN

# IPv6: symmetric drops, but ONLY if Docker actually manages a v6 DOCKER-USER
# chain (container IPv6 is off by default, so otherwise there is no v6 path to
# filter and creating an orphan chain would enforce nothing). fc00::/7 covers
# ULA incl. fd00:ec2::254-style v6 metadata; fe80::/10 link-local.
if command -v ip6tables >/dev/null 2>&1 && ip6tables -S DOCKER-USER >/dev/null 2>&1; then
  ip6tables -F DOCKER-USER
  ip6tables -A DOCKER-USER -m conntrack --ctstate ESTABLISHED,RELATED -j RETURN
  for IFACE in docker0 'br+'; do
    for CIDR in fc00::/7 fe80::/10; do
      ip6tables -A DOCKER-USER -i "$IFACE" -d "$CIDR" -j DROP
    done
  done
{% for port in sandbox_published_guarded_ports %}
  ip6tables -A DOCKER-USER -m conntrack --ctstate NEW -p tcp --dport {{ port }} -j DROP
{% endfor %}
  ip6tables -A DOCKER-USER -j RETURN
fi
