{
	"name": "agentarea-cli",
	"version": "0.0.0",
	"license": "Apache-2.0",
	"bin": "dist/cli.js",
	"type": "module",
	"engines": {
		"node": ">=16"
	},
	"scripts": {
		"build": "tsc",
		"dev": "tsc --watch",
		"test": "prettier --check . && xo && ava"
	},
	"files": [
		"dist"
	],
	"dependencies": {
		"ink": "^4.1.0",
		"meow": "^11.0.0",
		"react": "^18.2.0",
		"axios": "^1.16.1",
		"eventsource": "^2.0.2",
		"@zowe/secrets-for-zowe-sdk": "^8.8.3",
		"async-exit-hook": "^2.0.1",
		"conf": "^12.0.0"
	},
	"devDependencies": {
		"@sindresorhus/tsconfig": "^8.1.0",
		"@types/react": "^18.0.32",
		"@types/node": "^20.0.0",
		"@types/eventsource": "^1.1.11",
		"@vdemedes/prettier-config": "^2.0.1",
		"ava": "^5.2.0",
		"chalk": "^5.2.0",
		"eslint": "^9.39.4",
		"eslint-config-xo-react": "^0.30.1",
		"eslint-plugin-react": "^7.37.5",
		"eslint-plugin-react-hooks": "^7.0.1",
		"ink-testing-library": "^3.0.0",
		"prettier": "^2.8.7",
		"ts-node": "^10.9.2",
		"typescript": "^5.9.3",
		"webpack": "^5.106.1",
		"xo": "^0.61.1"
	},
	"ava": {
		"extensions": {
			"ts": "module",
			"tsx": "module"
		},
		"nodeArguments": [
			"--loader=ts-node/esm"
		]
	},
	"xo": {
		"react": true,
		"semicolon": true,
		"prettier": true,
		"rules": {
			"react/prop-types": "off"
		}
	},
	"prettier": "@vdemedes/prettier-config",
	"overrides": {
		"@eslint/plugin-kit@<0.3.4": "0.7.1",
		"axios@>=1.0.0 <1.15.2": "1.16.1",
		"brace-expansion@<1.1.13": "1.1.14",
		"brace-expansion@>=4.0.0 <5.0.6": "5.0.6",
		"diff@>=4.0.0 <4.0.4": "4.0.4",
		"fast-uri@<=3.1.1": "3.1.2",
		"json-schema-typed@8.0.1": "8.0.2",
		"minimatch@>=3.0.0 <3.1.5": "3.1.5",
		"ws@>=8.0.0 <8.20.1": "8.21.0"
	},
	"pnpm": {
		"overrides": {
			"@eslint/plugin-kit@<0.3.4": "0.7.1",
			"axios@>=1.0.0 <1.15.2": "1.16.1",
			"brace-expansion@<1.1.13": "1.1.14",
			"brace-expansion@>=4.0.0 <5.0.6": "5.0.6",
			"diff@>=4.0.0 <4.0.4": "4.0.4",
			"fast-uri@<=3.1.1": "3.1.2",
			"json-schema-typed@8.0.1": "8.0.2",
			"minimatch@>=3.0.0 <3.1.5": "3.1.5",
			"ws@>=8.0.0 <8.20.1": "8.21.0"
		}
	}
}
