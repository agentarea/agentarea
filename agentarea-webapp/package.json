{
  "name": "app",
  "version": "0.0.12",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "next dev",
    "dev:ssl": "PORT=443 next dev --experimental-https",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "type-check": "tsc --noEmit",
    "test:e2e": "playwright test",
    "test:e2e:real": "PLAYWRIGHT_REAL_STACK=1 playwright test --project=chromium-real-stack",
    "test:e2e:current-stand": "PLAYWRIGHT_REAL_STACK=1 PLAYWRIGHT_REUSE_SERVER=1 PLAYWRIGHT_BASE_URL=http://localhost:3000 playwright test --project=chromium-real-stack",
    "test:e2e:smoke": "PLAYWRIGHT_REAL_STACK=1 PLAYWRIGHT_REUSE_SERVER=1 PLAYWRIGHT_BASE_URL=http://localhost:3000 playwright test --project=chromium-real-stack ui-smoke detail-smoke",
    "test:e2e:ai": "PLAYWRIGHT_REAL_STACK=1 PLAYWRIGHT_REUSE_SERVER=1 PLAYWRIGHT_BASE_URL=http://localhost:3000 playwright test --project=chromium-ai-stack",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,css,md}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,json,css,md}\"",
    "generate:openapi": "curl -sf http://localhost:8000/openapi.json -o src/api/openapi.json",
    "generate:client": "openapi-ts",
    "generate:api": "pnpm generate:openapi && pnpm generate:client"
  },
