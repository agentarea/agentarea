# MCP data plane: the manager image running in MCP_MANAGER_MODE=dataplane.
#
# The same image the control plane runs, started with a mode that builds only a
# container backend — no database, no Redis, no secret manager. Losing this host
# loses container control here and no credential.
#
# The Docker socket is mounted because driving containers is this process's whole
# job, and this host's container runtime is already the trust boundary. Nothing
# else on the box may have it: the control plane stays elsewhere.
services:
  mcp-dataplane:
    image: {{ sandbox_mcp_dataplane_image }}
    container_name: mcp-dataplane
    restart: unless-stopped
    env_file:
      - /etc/mcp-dataplane/dataplane.env
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock
    # Published on loopback only. Public access is Caddy's job, which terminates
    # TLS in front of it; binding the port itself to the world would leave an
    # unencrypted path to container creation on a gVisor host.
    ports:
      - "127.0.0.1:{{ sandbox_mcp_dataplane_port }}:{{ sandbox_mcp_dataplane_port }}"
    networks:
      - {{ sandbox_mcp_dataplane_network }}
    healthcheck:
      test: ["CMD", "wget", "-qO-", "http://127.0.0.1:{{ sandbox_mcp_dataplane_port }}/healthz"]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 20s

networks:
  {{ sandbox_mcp_dataplane_network }}:
    name: {{ sandbox_mcp_dataplane_network }}
    external: true
