# Every variable AgentArea itself reads is prefixed AGENTAREA_. Unprefixed names
# below belong to a third-party image (postgres, rustfs, Kratos, Hydra, SMTP) and
# keep the name that image expects; compose maps our values into them.

# Database settings - Main PostgreSQL instance
AGENTAREA_DB_USER=postgres
AGENTAREA_DB_PASSWORD=postgres
AGENTAREA_DB_NAME=agentarea

# Database names (all on single PostgreSQL instance)
TEMPORAL_DB=temporal
KRATOS_DB=kratos

# Object storage settings
# RustFS is the default local S3-compatible object store used by docker-compose.
RUSTFS_ACCESS_KEY=minioadmin
RUSTFS_SECRET_KEY=minioadmin
RUSTFS_REGION=us-east-1
DOCUMENTS_BUCKET=ai-agents-bucket
ARTIFACTS_BUCKET=artifacts

## Secret Management Configuration
# Choose your secret storage backend: "database" (default) or "infisical"
# Note: Database type requires session and user_context (created per-request)
# AGENTAREA_SECRET_BACKEND=database  # Default, no need to set explicitly

# Database Secret Manager (used when AGENTAREA_SECRET_BACKEND=database)
# Encryption key for secrets stored in database
# The installer writes a fresh persistent key into .env; ./scripts/gen-dev-secrets.sh
# does the same for local development. Never copy a value from this file into a
# real deployment — anything committed here is public.
# Generate a key with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AGENTAREA_SECRET_ENCRYPTION_KEY=

## Sandbox runtime auth (HMAC shared secrets, must be >= 32 bytes)
# The control plane signs short-lived activation tokens the sandbox runner
# verifies before executing untrusted commands; the worker uses the cleanup
# secret to retire finished task sandboxes. Dev values only — set real secrets
# in production. compose fails hard if these are unset (no default there).
AGENTAREA_SBX_ACTIVATION_SECRET=dev-sandbox-activation-hmac-secret-change-in-prod
AGENTAREA_SBX_CLEANUP_SECRET=dev-sandbox-cleanup-hmac-secret-change-in-prod-00
AGENTAREA_SBX_FILE_SECRET=dev-sandbox-file-auth-secret-change-in-prod-000000
AGENTAREA_SBX_CONTROL_SECRET=dev-sandbox-control-auth-secret-change-in-prod-0000
AGENTAREA_MCP_GATEWAY_SECRET=dev-mcp-gateway-auth-secret-change-in-prod-00000000
AGENTAREA_MCP_LEASE_TTL=90s
AGENTAREA_MCP_STARTUP_TIMEOUT=5m

# Explicit sandbox lifecycle policy. Binaries fail startup when these are
# missing or malformed; there are no application-level retention defaults.
# Durations carry their unit in the value (ms/s/m/h/d), never in the name; the
# two *_SECONDS knobs below are plain integer seconds and say so.
AGENTAREA_SBX_LEASE_TTL=2h
AGENTAREA_SBX_PROVISION_TIMEOUT=30s
AGENTAREA_SBX_IDLE_TTL=15m
AGENTAREA_SBX_SESSION_TTL=24h
AGENTAREA_SBX_RECORD_TTL=24h
AGENTAREA_SBX_MAX_EXEC_SECONDS=1800
AGENTAREA_SBX_EXEC_SECONDS=120
AGENTAREA_SBX_QUEUE_TIMEOUT=5m
AGENTAREA_SBX_COMPLETION_GRACE=2m
AGENTAREA_SBX_ALLOW_INTERNET=false
# Sandbox activation process exits after this long without a request; 0s disables.
AGENTAREA_SBX_IDLE_SHUTDOWN=15m

AGENTAREA_REDIS_URL=redis://valkey:6379

# Ory Kratos (Identity Management)
NEXT_PUBLIC_ORY_SDK_URL=http://localhost:4433
NEXT_PUBLIC_API_URL=http://localhost:8000

# SMTP settings for email delivery
# Dev default targets the bundled mailpit container (plain SMTP on :1025, no
# STARTTLS). Captured mail is viewable at http://localhost:8025. For a real TLS
# provider set SMTP_PROTOCOL=smtps and SMTP_DISABLE_STARTTLS=false.
SMTP_PROTOCOL=smtp
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=user
SMTP_PASSWORD=pass
SMTP_FROM_EMAIL=noreply@agentarea.local
SMTP_FROM_NAME=AgentArea
SMTP_SKIP_SSL_VERIFY=true
SMTP_DISABLE_STARTTLS=true

# OIDC Social Login Configuration
# Google OAuth2 - Get credentials from: https://console.cloud.google.com/apis/credentials
# Callback URL: http://localhost:4433/self-service/methods/oidc/callback/google
OIDC_GOOGLE_CLIENT_ID=
OIDC_GOOGLE_CLIENT_SECRET=

# GitHub OAuth - Get credentials from: https://github.com/settings/developers
# Callback URL: http://localhost:4433/self-service/methods/oidc/callback/github
OIDC_GITHUB_CLIENT_ID=
OIDC_GITHUB_CLIENT_SECRET=

# Authentication Provider (for backend API)
AUTH_PROVIDER=kratos
# Kratos JWT settings.
# AGENTAREA_AUTH_JWKS_B64 holds the base64-encoded PUBLIC JWKS only — the backend
# just verifies tokens. Kratos signs with the private half, generated per-install
# into config/auth/kratos/jwks.json (gitignored). Run ./scripts/gen-dev-secrets.sh
# to produce both locally; scripts/install.sh does it for the quickstart.
AGENTAREA_AUTH_JWKS_B64=
AGENTAREA_AUTH_ISSUER=http://localhost:4433
AGENTAREA_AUTH_AUDIENCE=agentarea-api

# Ory secrets. Required — compose fails to start without them, and an empty
# value counts as missing, so copying this file is not enough on its own.
# Generate them with ./scripts/gen-dev-secrets.sh
# The cipher secret must be exactly 32 characters (xchacha20-poly1305).
KRATOS_SECRETS_COOKIE=
KRATOS_SECRETS_CIPHER=
HYDRA_SECRETS_SYSTEM=
HYDRA_SECRETS_COOKIE=
HYDRA_PAIRWISE_SALT=
