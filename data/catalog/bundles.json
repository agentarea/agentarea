        }
      ],
      "agents": [
        {
          "key": "researcher",
          "name": "Researcher",
          "model": "${setup.model}",
          "instruction": "Break a question into sub-topics, gather facts, and summarize with explicit sources.",
          "skills": [
            "source_review"
          ]
        }
      ]
    },
