# Ory Kratos Authentication (used for login/logout)
KRATOS_URL=http://localhost:4433

# AgentArea Backend API
API_URL=http://localhost:8000
API_TIMEOUT=30000
MAX_RETRIES=3
RETRY_DELAY=1000

# SSE Configuration
STREAM_TIMEOUT=60000

# Logging
LOG_LEVEL=info

# UI Configuration
THEME=auto

# Application
NODE_ENV=development
