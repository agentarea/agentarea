# Generated by deploy/sandbox-host/terraform. Do not edit by hand.
#
# The host has no public address. Ansible reaches it through a socat pod in the
# cluster that shares its private network:
#
#   kubectl -n agentarea run jump --image=alpine/socat --command -- sleep infinity
[sandbox_hosts]
${private_ip} ansible_user=root ansible_ssh_common_args='-o ProxyCommand="kubectl -n agentarea exec -i jump -- socat - TCP:%h:%p"'

[sandbox_hosts:vars]
sandbox_region=${region}

# Every service binds this address and nothing else. The host is reachable only
# from the cluster VPC, and the provider still hands it a global IPv6, so binding
# anything wider publishes it. Terraform writes these because it owns the address;
# the deployment policy that goes with them is in group_vars/sandbox_hosts.yml.
sandbox_mcp_dataplane_bind_address=${private_ip}
opensandbox_bind_address=${private_ip}
sandbox_ssh_listen_address=${private_ip}
sandbox_mcp_dataplane_id=${private_ip}
