[Unit]
Description=AgentArea MCP data plane
After=docker.service sandbox-egress.service
Requires=docker.service

[Service]
# Runs on the host rather than in a container: this process drives containers
# through the Docker CLI, which the host already has. Putting it in a container
# would mean shipping a second copy of that CLI and mounting the socket in, for
# no isolation gain — the process is the trusted half on a host whose container
# runtime is already the trust boundary.
Type=simple
EnvironmentFile=/etc/mcp-dataplane/dataplane.env
ExecStart={{ sandbox_mcp_dataplane_binary_dest }}
Restart=always
RestartSec=5

# The token lives in the environment file, not the command line, so it does not
# appear in the process table.
NoNewPrivileges=true
ProtectHome=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
