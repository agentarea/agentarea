services:
  opensandbox-server:
    image: "{{ opensandbox_server_image }}"
    container_name: opensandbox-server
    restart: unless-stopped
    network_mode: host
    user: "10001:10001"
    group_add:
      - "${DOCKER_GID}"
    env_file:
      - /etc/opensandbox/opensandbox.env
    environment:
      HOME: /var/lib/opensandbox
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock
      - /etc/opensandbox/config.toml:/etc/opensandbox/config.toml:ro
      - /var/lib/opensandbox:/var/lib/opensandbox
    read_only: true
    tmpfs:
      - /tmp:rw,noexec,nosuid,size=64m
    cap_drop:
      - ALL
    security_opt:
      - no-new-privileges:true
    pids_limit: 512
    mem_limit: 1g
    cpus: 1.0
    stop_grace_period: 20s
    logging:
      driver: json-file
      options:
        max-size: 50m
        max-file: "5"

  caddy:
    image: "{{ opensandbox_caddy_image }}"
    container_name: opensandbox-caddy
    restart: unless-stopped
    network_mode: host
    volumes:
      - /etc/opensandbox/Caddyfile:/etc/caddy/Caddyfile:ro
      - /var/lib/opensandbox/caddy-data:/data
      - /var/lib/opensandbox/caddy-config:/config
    cap_drop:
      - ALL
    cap_add:
      - NET_BIND_SERVICE
    security_opt:
      - no-new-privileges:true
    pids_limit: 256
    mem_limit: 256m
    cpus: 0.5
    logging:
      driver: json-file
      options:
        max-size: 20m
        max-file: "3"
